# Copy to .env (backend) or .env.local (frontend). Never commit real values.
# Real secrets are added per service as integrations go live; the fakes need none.

# --- frontend ---
# Where the Next.js server proxies /api/* to (server build only).
BACKEND_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- backend ---
PORT=4000
NODE_ENV=development
