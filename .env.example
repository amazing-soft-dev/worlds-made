# Copy to backend/.env (backend) or frontend/.env.local (frontend). Never commit real values.
# Every integration has a local fake, so none of these are needed to run or test the app.
# `npm run dev:fakes` starts the backend on fakes even when your shell has real keys set.

# ---------------------------------------------------------------- frontend
# Where the Next.js server proxies /api/* to (server build only).
BACKEND_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Email sign-in (Supabase REST). Leave empty locally to get a "dev sign-in" with no email.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Ads: production only, and only when all three are set. Under-13 and unknown ages get child treatment.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
# Error reporting (no personal data is sent).
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------- backend: core
PORT=4000
NODE_ENV=development
# The main site's origin (used for the game frame's frame-ancestors and Stripe return URLs).
SITE_URL=http://localhost:3000
# The SEPARATE origin that serves generated games. It must NOT be the site's origin, and in production it must be
# a different registrable domain. Locally 127.0.0.1:4000 differs from localhost:3000.
GAME_ORIGIN=http://127.0.0.1:4000
# Long random strings. Required in production.
COOKIE_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-to-a-long-random-string
# Comma-separated emails allowed to use /api/admin.
FOUNDER_EMAILS=

# ---------------------------------------------------------------- backend: integrations (all optional locally)
# Supabase: Postgres, Auth and Storage. Run backend/src/db/migrations/*.sql in order.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
# Any OpenAI-style chat-completions endpoint (the model provider is open), and its per-million-token prices.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0
# Moderation: OpenAI Moderation endpoint, plus your own extra blocked terms (comma separated).
OPENAI_API_KEY=
MODERATION_EXTRA_TERMS=
# RAWG Business plan (commercial use). Affiliate tags: {"store.example.com":"ref=worldsmade"}
RAWG_API_KEY=
AFFILIATE_TAGS={}
# Stripe: Checkout, Customer Portal, and the webhook at POST /api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Resend: contact form and report notices.
RESEND_API_KEY=
MAIL_FROM=Worlds Made <no-reply@worldsmade.example>
MAIL_TO=hello@worldsmade.example

# ---------------------------------------------------------------- backend: cost controls
# Builds stop when the month's logged model cost reaches this, or when the off switch is on.
MONTHLY_SPEND_CAP_USD=100
BUILDS_PAUSED=false
