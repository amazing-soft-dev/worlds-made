{
  "name": "worlds-made",
  "version": "0.1.0",
  "private": true,
  "description": "AI game site: describe a game, play it, share it. Frontend (Next.js), backend (Fastify), shared schemas.",
  "license": "Apache-2.0",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "check:images": "npm run check:images -w frontend",
    "check:a11y": "npm run check:a11y -w frontend",
    "test:e2e": "npm run test:e2e -w backend",
    "check:sandbox": "npm run check:sandbox -w frontend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.73.0"
  }
}
