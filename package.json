{
  "name": "worlds-made",
  "version": "0.1.0",
  "private": true,
  "description": "AI game site: describe a game, play it, share it. Frontend (Next.js), backend (Fastify), shared schemas.",
  "license": "Apache-2.0",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
